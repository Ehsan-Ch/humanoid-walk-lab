<mujoco model="planar_humanoid">
  <compiler angle="radian"/>
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>
  <default>
    <joint damping="0.4" armature="0.03" limited="true"/>
    <geom friction="0.9 0.02 0.002" condim="3" contype="1" conaffinity="0" rgba="0.23 0.65 0.71 1"/>
    <motor ctrllimited="true" ctrlrange="-80 80"/>
  </default>
  <worldbody>
    <light pos="0 -3 5" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="100 10 .1" conaffinity="1" rgba="0.15 0.2 0.28 1"/>
    <body name="pelvis" pos="0 0 .80">
      <joint name="root_x" type="slide" axis="1 0 0" limited="false" damping="0" armature="0"/>
      <joint name="root_z" type="slide" axis="0 0 1" ref=".80" limited="false" damping="0" armature="0"/>
      <joint name="root_pitch" type="hinge" axis="0 1 0" limited="false" damping="0" armature="0"/>
      <geom name="torso" type="capsule" fromto="0 0 0 0 0 .38" size=".09" mass="9"/>
      <geom name="head" type="sphere" pos="0 0 .55" size=".11" mass="1.4"/>
      <geom name="left_arm" type="capsule" fromto="0 .15 .35 .03 .22 .02" size=".035" mass=".8"/>
      <geom name="right_arm" type="capsule" fromto="0 -.15 .35 .03 -.22 .02" size=".035" mass=".8"/>
      <body name="left_thigh" pos="0 .10 0">
        <joint name="left_hip" axis="0 1 0" range="-1.3 1.3"/>
        <geom type="capsule" fromto="0 0 0 0 0 -.36" size=".05" mass="2"/>
        <body name="left_shin" pos="0 0 -.36">
          <joint name="left_knee" axis="0 1 0" range="-.05 1.8"/>
          <geom type="capsule" fromto="0 0 0 0 0 -.36" size=".04" mass="1.3"/>
          <body name="left_foot" pos="0 0 -.36">
            <joint name="left_ankle" axis="0 1 0" range="-.9 .9"/>
            <geom name="left_sole" type="box" pos=".045 0 -.035" size=".125 .065 .035" mass=".5"/>
          </body>
        </body>
      </body>
      <body name="right_thigh" pos="0 -.10 0">
        <joint name="right_hip" axis="0 1 0" range="-1.3 1.3"/>
        <geom type="capsule" fromto="0 0 0 0 0 -.36" size=".05" mass="2" rgba=".95 .58 .26 1"/>
        <body name="right_shin" pos="0 0 -.36">
          <joint name="right_knee" axis="0 1 0" range="-.05 1.8"/>
          <geom type="capsule" fromto="0 0 0 0 0 -.36" size=".04" mass="1.3" rgba=".95 .58 .26 1"/>
          <body name="right_foot" pos="0 0 -.36">
            <joint name="right_ankle" axis="0 1 0" range="-.9 .9"/>
            <geom name="right_sole" type="box" pos=".045 0 -.035" size=".125 .065 .035" mass=".5" rgba=".95 .58 .26 1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor joint="left_hip"/><motor joint="left_knee"/><motor joint="left_ankle" ctrlrange="-35 35"/>
    <motor joint="right_hip"/><motor joint="right_knee"/><motor joint="right_ankle" ctrlrange="-35 35"/>
  </actuator>
</mujoco>
